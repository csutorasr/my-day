{
  "name": "my-day",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --test skills/loop/test/*.test.mjs",
    "test:e2e": "npm run ui:build && playwright test --config skills/loop/e2e/playwright.config.mjs",
    "ui:dev": "vite --config skills/loop/ui/vite.config.js",
    "ui:demo": "node skills/loop/e2e/demo.mjs",
    "ui:dev:demo": "MY_DAY_URL=http://127.0.0.1:4712 vite --config skills/loop/ui/vite.config.js",
    "ui:build": "vite build --config skills/loop/ui/vite.config.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  },
  "workspaces": [
    "skills/loop/ui"
  ]
}
